# ==============================================================================
# NeuralForge AI — Kubernetes Worker Cluster Configuration
# ==============================================================================

# IP or FQDN of the Central Control Server (FastAPI, Redis, MinIO, MLflow)
CONTROL_HOST=192.168.10.252

# Port Configuration
REDIS_PORT=23437
REDIS_DB=0
MINIO_PORT=9000
MLFLOW_PORT=5000

# Dozzle Real-Time Log Viewer Host Port
DOZZLE_HOST_PORT=8888

# Storage / CIFS Credentials
CIFS_SHARE_NAME=wyolo
CIFS_USER=wyolo
CIFS_PASS=wyolo

# S3 / MinIO Credentials
MINIO_ROOT_USER=wyolo
MINIO_ROOT_PASSWORD=wyolopassword

# Container Image Releases
INVOKER_IMAGE=wisrovi/train_service:worker_invoker_v1.0.0
EXECUTOR_IMAGE=wisrovi/train_service:worker_executor_v1.0.0
DOZZLE_IMAGE=amir20/dozzle:latest
